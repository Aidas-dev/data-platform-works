{
  "tagname-lowercase": true,
  "attr-lowercase": true,
  "attr-value-double-quotes": false,  # Hugo minifier strips quotes — valid HTML5
  "tag-pair": true,
  "spec-char-escape": true,
  "id-unique": true,
  "src-not-empty": true,
  "attr-no-duplication": true,
  "title-require": true,
  "doctype-first": true,
  "head-script-disabled": false
}
